# Supabase Proje Bilgileri (Canlı mod için gereklidir; boş bırakılırsa Demo Modu kullanılabilir)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Strava OAuth Bilgileri (Client Secret sadece Supabase Edge Function secrets içinde tutulmalıdır)
VITE_STRAVA_CLIENT_ID=your-strava-client-id
VITE_STRAVA_REDIRECT_URI=http://localhost:5173/login

# İsteğe bağlı: "true" yapılırsa Supabase tanımlı olsa bile Demo Modu seçeneğini vurgular
VITE_DEMO_MODE=false
